<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="CalculateurAge.MainPage" Title="Calculateur d'âge">
    <VerticalStackLayout Padding="24" Spacing="16">
        <Label Text="Date de naissance" FontAttributes="Bold" />
        <DatePicker x:Name="BirthPicker" />
        <Button Text="Calculer" Clicked="OnCalculate" />
        <Label x:Name="ResultLabel" FontSize="22" />
        <Label x:Name="NextLabel" />
    </VerticalStackLayout>
</ContentPage>
